PORT=8080
# The main listener defaults to loopback. Keep it behind a local TLS reverse proxy.
PHONEPILOT_MAIN_BIND=127.0.0.1
# auto selects the private IPv4 address used by the primary route. Use off to disable.
PHONEPILOT_LAN_BIND=auto:8081
PHONEPILOT_SERVER_ID_FILE=data/server-id
# An external HTTPS origin; leave empty for local legacy mode.
PHONEPILOT_PUBLIC_URL=
# 32 random bytes encoded as unpadded Base64URL. Required with PUBLIC_URL.
PHONEPILOT_CAMERA_SECRET_B64URL=
ADMIN_LOGIN=admin
ADMIN_PASSWORD=ChangeMe123!
IVAN_PASSWORD=Ivan123!
SASHA_PASSWORD=Sasha123!
YEHOR_PASSWORD=Yehor123!

# true when HTTPS is terminated directly in front of this process and the browser uses HTTPS.
COOKIE_SECURE=false

STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

ENABLE_BROWSER_CAMERA_TEST=true

CAMERA_DISCONNECT_GRACE_MS=15000
VIEWER_SIGNALING_GRACE_MS=15000
WEBRTC_NEGOTIATION_TIMEOUT_MS=20000
MAX_VIEWERS_PER_CAMERA=4

SERVO_MIN_ANGLE=0
SERVO_MAX_ANGLE=180
SERVO_STEP=5
SERVO_COMMAND_INTERVAL_MS=80
